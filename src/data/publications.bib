@INPROCEEDINGS{8658402,
  author={Kim, Sookyung and Kim, Hyojin and Lee, Joonseok and Yoon, Sangwoong and Kahou, Samira Ebrahimi and Kashinath, Karthik and Prabhat, Mr},
  booktitle={2019 IEEE Winter Conference on Applications of Computer Vision (WACV)}, 
  title={Deep-Hurricane-Tracker: Tracking and Forecasting Extreme Climate Events}, 
  year={2019},
  volume={},
  number={},
  pages={1761-1769},
  abstract={Tracking and predicting extreme events in large-scale spatio-temporal climate data are long standing challenges in climate science. In this paper, we propose Convolutional LSTM (ConvLSTM)-based spatio-temporal models to track and predict hurricane trajectories from large-scale climate data; namely, pixel-level spatio-temporal history of tropical cyclones. To address the tracking problem, we model time-sequential density maps of hurricane trajectories, enabling to capture not only the temporal dynamics but also spatial distribution of the trajectories. Furthermore, we introduce a new trajectory prediction approach as a problem of sequential forecasting from past to future hurricane density map sequences. Extensive experiment on actual 20 years record shows that our ConvLSTM-based tracking model significantly outperforms existing approaches, and that the proposed forecasting model achieves successful mapping from predicted density map to ground truth.},
  keywords={Meteorology;Hurricanes;Predictive models;Trajectory;Forecasting;Event detection;Videos},
  doi={10.1109/WACV.2019.00192},
  url={https://ieeexplore.ieee.org/abstract/document/8658402},
  ISSN={1550-5790},
  month={1},
  cvcategory = {conference},
  cvstatus = {published}
}



@ARTICLE{9600832,
  author={Park, Kyu Min and Park, Younghyo and Yoon, Sangwoong and Park, Frank C.},
  journal={IEEE/ASME Transactions on Mechatronics}, 
  title={Collision Detection for Robot Manipulators Using Unsupervised Anomaly Detection Algorithms}, 
  year={2022},
  volume={27},
  number={5},
  pages={2841-2851},
  abstract={Collaborative robot manipulators operating in dynamic and unstructured environments shared with humans require fast and accurate detection of collisions. When using model-based detection methods without joint torque sensors, proper treatment for friction in the motors is required, such as accurate modeling of friction parameters. In our previous work, we have presented two supervised learning-based detection methods, which successfully compensate for uncertain dynamic effects, including unmodeled friction. However, robot collision data are required for training and only the scenarios that are learned as collisions can be robustly detected. In this article, we present two collision detection methods using unsupervised anomaly detection algorithms—a one-class support vector machine, and an autoencoder—for robot manipulators. Only the motor current measurements together with a robot dynamics model are required while no additional external sensors, friction modeling, or manual tuning of multiple detection thresholds are needed. Extensive experiments with a robot collision dataset collected with a six-joint robot manipulator validate that our unsupervised detection algorithms can robustly detect a variety of hard and soft collisions with very light computation using only the data for collision-free motions and without the knowledge of every possible type of collision that can occur.},
  keywords={Collision avoidance;Robot sensing systems;Sensors;Heuristic algorithms;Friction;Torque;Dynamics;Collision detection;physical human–robot interaction (pHRI);robot manipulator;unsupervised learning},
  doi={10.1109/TMECH.2021.3119057},
  url={https://ieeexplore.ieee.org/abstract/document/9600832},
  ISSN={1941-014X},
  month={10},
  cvcategory = {journal},
  cvstatus = {published},
  cvimpactfactor = {6.1},
  cvjcrtoppercent = {15.5}
}


