---
import type { ImageMetadata } from 'astro';
import { getImage, Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { getPhotosByYear } from '../lib/data';
import { inlineMd } from '../lib/format';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}', {
  eager: true,
});
const imageOf = (file: string) => {
  const img = files[`../assets/photos/${file}`];
  if (!img) throw new Error(`photos.yaml: src/assets/photos/${file} not found`);
  return img.default;
};

const years = await Promise.all(
  (await getPhotosByYear()).map(async ([year, photos]) => [
    year,
    await Promise.all(
      photos.map(async (p) => {
        const src = imageOf(p.file);
        const full = await getImage({ src, width: Math.min(src.width, 2000), format: 'jpg', quality: 85 });
        return { ...p, src, full: full.src };
      }),
    ),
  ] as const),
);
---

<Base title="Photos">
  <h1>Photos</h1>
  {years.length === 0 && <p class="empty">Photos coming soon.</p>}
  {
    years.map(([year, photos]) => (
      <>
        <h2>{year}</h2>
        <div class="gallery">
          {photos.map((p) => (
            <figure>
              <a href={p.full} target="_blank" rel="noopener">
                <Image src={p.src} alt={inlineMd(p.caption).replace(/<[^>]+>/g, '')} widths={[400, 800]} sizes="(max-width: 640px) 100vw, 300px" />
              </a>
              {p.caption && <figcaption set:html={inlineMd(p.caption)} />}
            </figure>
          ))}
        </div>
      </>
    ))
  }
</Base>

<style>
  .empty {
    color: var(--muted);
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.5rem 1.25rem;
    align-items: start;
  }
  figure {
    margin: 0;
  }
  figure a {
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--bg-soft);
  }
  figure img {
    width: 100%;
    transition: transform 0.2s;
  }
  figure a:hover img {
    transform: scale(1.03);
  }
  figcaption {
    margin-top: 0.5rem;
    font-size: 0.92rem;
    color: var(--muted);
  }
</style>
