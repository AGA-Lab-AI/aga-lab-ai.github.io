---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const SITE = 'UNIST AGA Lab';
const { title, description = 'Active Generative Agents Lab at UNIST Graduate School of AI' } = Astro.props;
const fullTitle = title ? `${title} | ${SITE}` : `${SITE} — Active Generative Agents Lab`;

const nav = [
  { href: '/', label: 'Home' },
  { href: '/people/', label: 'People' },
  { href: '/publications/', label: 'Publications' },
  { href: '/news/', label: 'News' },
  { href: '/research-statement/', label: 'Research' },
  { href: '/recruiting/', label: 'Recruiting' },
];
const path = Astro.url.pathname.replace(/\/?$/, '/');
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:image" content={new URL('/images/logo-512.png', Astro.site)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,500;8..60,600&display=swap"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="container bar">
        <a class="brand" href="/">
          <img src="/images/logo.png" alt="" width="36" height="36" />
          <span>UNIST <strong>AGA</strong> Lab</span>
        </a>
        <input type="checkbox" id="nav-toggle" aria-label="Toggle menu" />
        <label for="nav-toggle" class="nav-button" aria-hidden="true">☰</label>
        <nav>
          {nav.map((n) => (
            <a href={n.href} class={isActive(n.href) ? 'active' : undefined}>{n.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>
          Active Generative Agents Lab ·
          <a href="https://aigs.unist.ac.kr/eng/index.php">UNIST Graduate School of AI</a> · Ulsan, Republic of Korea
        </p>
        <p class="muted">© {new Date().getFullYear()} AGA Lab</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
    background: var(--bg);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 60px;
    gap: 1rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-shrink: 0;
    white-space: nowrap;
    font-family: var(--serif);
    font-size: 1.25rem;
    color: var(--fg);
    letter-spacing: 0.02em;
  }
  .brand img {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: 7px;
  }
  .brand strong {
    color: var(--accent);
  }
  .brand:hover {
    text-decoration: none;
  }
  nav {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
  }
  nav a {
    color: var(--muted);
    font-size: 0.95rem;
    font-weight: 500;
    padding: 0.25rem 0;
    border-bottom: 2px solid transparent;
  }
  nav a:hover {
    color: var(--fg);
    text-decoration: none;
  }
  nav a.active {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
  #nav-toggle,
  .nav-button {
    display: none;
  }
  @media (max-width: 760px) {
    .bar {
      flex-wrap: wrap;
    }
    .nav-button {
      display: block;
      font-size: 1.4rem;
      cursor: pointer;
      padding: 0.25rem 0.5rem;
    }
    nav {
      display: none;
      flex-direction: column;
      width: 100%;
      gap: 0.25rem;
      padding-bottom: 0.75rem;
    }
    #nav-toggle:checked ~ nav {
      display: flex;
    }
  }
  .site-footer {
    border-top: 1px solid var(--line);
    background: var(--bg-soft);
    font-size: 0.88rem;
    padding-block: 1.5rem;
  }
  .site-footer p {
    margin: 0.2rem 0;
  }
</style>
