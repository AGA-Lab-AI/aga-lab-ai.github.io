---
import { formatMonth, inlineMd } from '../lib/format';

interface Props {
  items: { date: string; text: string }[];
}
const { items } = Astro.props;
---

<ul class="news">
  {
    items.map((n) => (
      <li>
        <time datetime={n.date}>{formatMonth(n.date)}</time>
        <span set:html={inlineMd(n.text)} />
      </li>
    ))
  }
</ul>

<style>
  .news {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .news li {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 0.75rem;
    padding: 0.55rem 0;
    border-bottom: 1px dashed var(--line);
  }
  .news li:last-child {
    border-bottom: 0;
  }
  time {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    font-size: 0.92rem;
    padding-top: 0.08rem;
    white-space: nowrap;
  }
  @media (max-width: 520px) {
    .news li {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
